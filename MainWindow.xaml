<Window x:Class="TotpViewerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOTP" Height="720" Width="430"
        Icon="assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,18,20,10" Background="White">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Authenticator" FontSize="24" FontWeight="SemiBold" Foreground="#202124" />
                    <TextBlock Text="Kodun üstüne tıklayınca kopyalanır" FontSize="12" Foreground="#5F6368" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="⋮" Width="38" Height="38" FontSize="22" BorderThickness="0" Background="White" Foreground="#5F6368" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <ListBox x:Name="AccountsList" Grid.Row="1" BorderThickness="0" Background="White" ItemsSource="{Binding Rows}" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="22,16" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Issuer}" FontSize="14" Foreground="#3C4043" />
                                <TextBlock Text="{Binding Username}" FontSize="11" Foreground="#80868B" Margin="0,2,0,8" />
                                <TextBlock Text="{Binding Code}" FontSize="34" FontWeight="Light" Foreground="#1A73E8" Cursor="Hand" MouseLeftButtonUp="Code_Click" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="46" Height="46" VerticalAlignment="Center">
                                <Ellipse Stroke="#E8EAED" StrokeThickness="4" />
                                <TextBlock Text="{Binding Remaining}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#5F6368" />
                            </Grid>
                            <Button Grid.Column="2" Content="⋮" Width="38" Height="38" Padding="0"
                                    FontSize="22" BorderThickness="0"
                                    Background="White" Foreground="#5F6368" Cursor="Hand"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Tag="{Binding}" Click="RowMenu_Click" ToolTip="Seçenekler">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Sil"
                                                  Click="DeleteRow_Click"
                                                  CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Content="+" Grid.RowSpan="2" Width="62" Height="62" FontSize="34" FontWeight="Light"
                Background="#FFFFFF" Foreground="#1A73E8" BorderBrush="#DADCE0" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Click="AddButton_Click">
            <Button.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.22" />
            </Button.Effect>
        </Button>

        <!-- Açılış ekranı (overlay) — Loaded sonrası fade-out olur -->
        <!-- Arka plan logodaki gradyanla eşleşir: #14A1FD -> #0063E2 -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="2" Panel.ZIndex="100">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#14A1FD" Offset="0" />
                    <GradientStop Color="#0063E2" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Border Width="300" Height="300" CornerRadius="66"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.35" Color="#001F4D" />
                </Border.Effect>
                <Border.Background>
                    <ImageBrush ImageSource="/assets/winotp-logo.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>
    </Grid>
</Window>
