<Window x:Class="TotpViewerWpf.QrScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Tara" Width="390" Height="260" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
    <StackPanel Margin="26" VerticalAlignment="Center">
        <TextBlock Text="QR Tara" FontSize="22" FontWeight="SemiBold" Foreground="#202124" Margin="0,0,0,12" />
        <TextBlock Text="Şimdilik QR görsel dosyası seçerek okutma desteklenir. Google Authenticator dışa aktar QR görselini de seçebilirsin." TextWrapping="Wrap" Foreground="#5F6368" Margin="0,0,0,18" />
        <Button Content="QR Resmi Seç" Height="46" Click="SelectImage_Click" />
    </StackPanel>
</Window>
